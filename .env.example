# Público (se expone al cliente)
PUBLIC_SITE_URL=http://localhost:4321

# GitHub Pages de proyecto: /nombre-del-repositorio
# Déjalo sin definir para servir en la raíz (localhost, dominio propio o repo <usuario>.github.io).
# BASE_PATH=/proyecto-web

# Solo servidor. No usar el prefijo PUBLIC_ para secretos.
# Genera secretos con: openssl rand -base64 32
# DATABASE_URL=
# AUTH_SECRET=
# SESSION_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SMTP_URL=
